module

public import Mathlib

/-!
# Two exceptional Hodge classes of Fermat varieties have length exactly seven

Let `R_d` be the free abelian group on the nonzero residues modulo `d`. A Hodge class of a Fermat variety of degree
`d` gives an element of `R_d`, and the classes in the subgroup `D_d + S_d`, generated by the linear and by Aoki's
standard tuples, are algebraic. Miranda, Movasati, Rufino and Villaflor (arXiv:2609.27301) define the length
`ℓ_{2,d}(α)` as the least number of residues, with multiplicity, of an element that differs from `α` by an element
of `D_d + S_d`; a class of length at most six is algebraic (their Proposition 4.3). With this they prove the Hodge
conjecture for the Fermat varieties of degree less than 65, except 44, 51 and 52. Their tables give the upper bound
`7` for the exceptional class `ξ` in degrees 44 and 52.

Here the length is computed exactly in those two degrees: it is seven. So Proposition 4.3 cannot be applied to them
through `ℓ_{2,44}` or `ℓ_{2,52}`.

This does not prove the Hodge conjecture for any variety, and it says nothing about representatives in multiples of
the degree, which is how the paper lifts a class. `xi44` is the representative printed in Table 2 of the paper. The
paper prints no representative of `ξ_52` in degree 52; that `xi52` is in its class was checked by computer outside
Lean, and the theorems about `xi52` do not depend on it.
-/

@[expose] public section

namespace FermatLength

/-- The nonzero residues modulo `d`. -/
abbrev Res (d : ℕ) := {a : ZMod d // a ≠ 0}

/-- `R_d`, the free abelian group on the nonzero residues modulo `d`. -/
abbrev R (d : ℕ) := Res d →₀ ℤ

/-- The element `(a₁) + ⋯ + (aₗ)` of `R_d`. -/
noncomputable def tuple {d : ℕ} (l : List (Res d)) : R d :=
  (l.map fun a => Finsupp.single a 1).sum

/-- The length `Σ |nᵢ|` of `Σ nᵢ (aᵢ)`. -/
def len {d : ℕ} (α : R d) : ℕ := α.sum fun _ n => n.natAbs

/-- `D_d`, the module of linear tuples: it is generated by the pairs `(a) + (-a)` and, when `d` is even, by
`ε = (d / 2)`. -/
noncomputable def D (d : ℕ) : AddSubgroup (R d) := AddSubgroup.closure
  ({r | ∃ a b : Res d, a.1 + b.1 = 0 ∧ r = tuple [a, b]} ∪ {r | ∃ e : Res d, e.1 + e.1 = 0 ∧ r = tuple [e]})

/-- The entries of Aoki's standard tuple `s_{p,i}`, for `d = p k`. -/
def standard (d p k : ℕ) (i : ZMod d) : List (ZMod d) :=
  if p = 2 then [i, k + i, -2 * i, k] else (List.range p).map (fun j => (j * k : ℕ) + i) ++ [-p * i]

/-- `S_d`, the module of standard tuples, generated by the `s_{p,i}` with `p` prime, `d = p k`, `3 ≤ k`, `p ∤ i`
and nonzero entries. -/
noncomputable def S (d : ℕ) : AddSubgroup (R d) := AddSubgroup.closure
  {r | ∃ (p k : ℕ) (i : ZMod d) (l : List (Res d)), p.Prime ∧ d = p * k ∧ 3 ≤ k ∧ ¬ p ∣ i.val ∧
    l.map Subtype.val = standard d p k i ∧ r = tuple l}

/-- The same without the condition `p ∤ i`. -/
noncomputable def SAll (d : ℕ) : AddSubgroup (R d) := AddSubgroup.closure
  {r | ∃ (p k : ℕ) (i : ZMod d) (l : List (Res d)), p.Prime ∧ d = p * k ∧ 3 ≤ k ∧
    l.map Subtype.val = standard d p k i ∧ r = tuple l}

/-- The length of `α` modulo a subgroup `G`: the least length of an element `β` with `α - β ∈ G`. -/
noncomputable def lenMod {d : ℕ} (G : AddSubgroup (R d)) (α : R d) : ℕ :=
  sInf {n | ∃ β : R d, α - β ∈ G ∧ len β = n}

/-- The seven-element representative of the exceptional class in degree 44. -/
def xi44 : List (Res 44) :=
  [⟨8, by decide⟩, ⟨11, by decide⟩, ⟨15, by decide⟩, ⟨19, by decide⟩, ⟨27, by decide⟩, ⟨31, by decide⟩, ⟨43, by decide⟩]

/-- The seven-element representative of the exceptional class in degree 52. -/
def xi52 : List (Res 52) :=
  [⟨1, by decide⟩, ⟨5, by decide⟩, ⟨9, by decide⟩, ⟨33, by decide⟩, ⟨37, by decide⟩, ⟨48, by decide⟩, ⟨49, by decide⟩]

/-- **The length of `ξ` in degree 44 is exactly seven**: no element of `R_44` of length at most six differs from
`ξ` by an element of `D_44 + S_44`. -/
theorem lenMod_xi44 : lenMod (D 44 ⊔ S 44) (tuple xi44) = 7 := by
  sorry

/-- The same modulo the larger subgroup generated by `D_44` and all the standard tuples, without the condition
`p ∤ i`. -/
theorem lenMod_xi44_all : lenMod (D 44 ⊔ SAll 44) (tuple xi44) = 7 := by
  sorry

/-- **The length of `ξ` in degree 52 is exactly seven**: no element of `R_52` of length at most six differs from
`ξ` by an element of `D_52 + S_52`. -/
theorem lenMod_xi52 : lenMod (D 52 ⊔ S 52) (tuple xi52) = 7 := by
  sorry

/-- The same modulo the larger subgroup generated by `D_52` and all the standard tuples, without the condition
`p ∤ i`. -/
theorem lenMod_xi52_all : lenMod (D 52 ⊔ SAll 52) (tuple xi52) = 7 := by
  sorry

end FermatLength
